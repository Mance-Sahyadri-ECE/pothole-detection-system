# AI Microservice Environment Variables (FastAPI / YOLO)

# Service Port (Render automatically supplies PORT in production)
PORT=8000

# Backend API Endpoint URL for pushing automated detections
BACKEND_API_URL=https://pothole-backend.onrender.com

# Model File Location
MODEL_PATH=model/best.pt

# YOLO Confidence Threshold (0.0 - 1.0)
YOLO_CONFIDENCE=0.40

# Maximum Allowed Image File Upload Size (in MB)
MAX_IMAGE_SIZE_MB=10
