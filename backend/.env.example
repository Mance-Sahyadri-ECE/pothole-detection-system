# Backend Environment Variables (Node.js / Express / Prisma)

# Server Port (Render automatically supplies PORT in production)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# PostgreSQL Database Connection String (Supabase / Neon / Render Postgres)
# Example: postgresql://postgres:password@ep-sample-12345.aws.neon.tech/pothole_db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/pothole_db?schema=public

# Allowed CORS Origins (Comma-separated if deploying multiple frontend domains)
CORS_ORIGIN=https://pothole-detection-system.vercel.app

# Frontend URL (Primary frontend origin fallback)
FRONTEND_URL=https://pothole-detection-system.vercel.app

# AI Ingest / Prediction Microservice URL
AI_SERVICE_URL=https://pothole-ai-service.onrender.com

# JWT Authentication Secret Key (Required for signing government/field engineer tokens)
JWT_SECRET=super-secret-jwt-key-replace-with-secure-random-hash

# Robot Ingest API Key (Matches hardware header 'x-robot-key')
ROBOT_API_KEY=robot-sec-key-7781-x9

# Supabase Integration (Optional if utilizing direct Supabase Client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
