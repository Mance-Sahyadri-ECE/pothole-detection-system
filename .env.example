# Root / Frontend Environment Variables (Vite)
# Do NOT place sensitive secrets here as Vite bundles these into public client JS.

# Production API Endpoint (Replace with your deployed Render backend URL)
VITE_API_URL=https://pothole-backend.onrender.com

# WebSocket Server Endpoint (Optional)
VITE_WS_URL=wss://pothole-backend.onrender.com
